VITE_API_URL=http://localhost:8000
VITE_AUTH_URL=http://localhost:5000
# Optional public QQ relay for recovering source reads blocked by the hosting IP.
VITE_TRUYENQQ_EDGE_URL=https://mangahub-mangadex-edge.vinhytb3010.workers.dev/api/truyenqq-edge
VITE_HASH_SALT=your-secret-salt-here-generate-a-random-string
# Google reCAPTCHA v2 checkbox PUBLIC site key (never put the secret key here).
# Add the website domains in Google's console; rebuild/redeploy after changing.
VITE_RECAPTCHA_SITE_KEY=your-google-recaptcha-v2-site-key
# Optional when the worker is routed on another domain. Same-origin
# /api/mangadex-edge is used by default.
VITE_MANGADEX_EDGE_URL=https://mangahub.art/api/mangadex-edge

# Server-side Vercel routing middleware only. Never prefix these with VITE_.
# Keep disabled until Access covers the frontend hostnames and valid login works.
CF_ACCESS_REQUIRED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# When Access is enabled, use the protected SAME-ORIGIN QQ Worker route:
# VITE_TRUYENQQ_EDGE_URL=https://mangahub.art/api/truyenqq-edge
