# Flask
FLASK_SECRET_KEY=manghub-deno9099-flask-2026-secret
FLASK_PORT=5000
FLASK_DEBUG=false
ALLOW_DEV_SECRET_FALLBACK=false

# FastAPI
FASTAPI_PORT=8000
# true = auto-reload (dev), false = allow multi-worker mode
FASTAPI_RELOAD=true
# 0 = auto (use up to 4 workers based on CPU), ignored when FASTAPI_RELOAD=true
FASTAPI_WORKERS=0

# MangaDex transport (auto|curl_cffi|httpx)
# VPS behind Cloudflare should use curl_cffi impersonation.
MANGADEX_TRANSPORT=curl_cffi
MANGADEX_RETRIES=3
MANGADEX_TIMEOUT_SECONDS=25
MANGADEX_CONNECT_TIMEOUT_SECONDS=10
MANGADEX_RETRY_BACKOFF_SECONDS=0.35
MANGADEX_CURL_WORKERS=8
MANGADEX_CURL_IMPERSONATE=chrome131

# Redis (optional - for caching & celery)
REDIS_URL=redis://localhost:6379/0

# CORS
FRONTEND_URL=http://localhost:8080
CORS_ALLOW_LOCALHOST=false

# Image proxy
IMAGE_PROXY_MAX_MB=16
IMAGE_CACHE_MAX_MB=512
IMAGE_CACHE_PRUNE_COOLDOWN_SECONDS=30
IMAGE_PROXY_CURL_WORKERS=8
MANGADEX_IMAGE_CACHE_VERSION=3
MANGADEX_IMAGE_UPSTREAM_CONCURRENCY=3
MANGADEX_IMAGE_THROTTLE_BACKOFF_SECONDS=0.8

# SEO sitemap
SITEMAP_CACHE_TTL_SECONDS=1800
SITEMAP_OTRUYEN_PAGE_LIMIT=30
SITEMAP_OTRUYEN_BATCH_SIZE=10
SITEMAP_OTRUYEN_TIMEOUT_SECONDS=24
SITEMAP_MANGADEX_TIMEOUT_SECONDS=10

# Google reCAPTCHA v2
RECAPTCHA_SECRET_KEY=your-google-recaptcha-v2-secret-key
RECAPTCHA_REQUIRED=true
RECAPTCHA_TIMEOUT_SECONDS=5

# Support email / SMTP
# Hostinger mailbox example: sender admin@mangahub.art -> support inbox cskh.mangahub@gmail.com.
SUPPORT_EMAIL=cskh.mangahub@gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=admin@mangahub.art
SMTP_PASSWORD=Deno9099@
SMTP_FROM_EMAIL=admin@mangahub.art
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15

# JWT
JWT_SECRET_KEY=manghub-deno9099-flask-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_COOKIE_MAX_AGE_SECONDS=157680000
REFRESH_ROTATION_GRACE_SECONDS=7200

# OpenRouter (AI Translation)
# Used by the editor's OCR+Translate feature (nvidia/nemotron model)
OPENROUTER_API_KEY=sk-or-v1-xxx
