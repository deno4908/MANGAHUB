# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Flask
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_FLASK_SECRET
BACKEND_BIND_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
ALLOW_DEV_SECRET_FALLBACK=false

# FastAPI
FASTAPI_PORT=8000
# true = auto-reload (dev), false = allow multi-worker mode
FASTAPI_RELOAD=true
# 0 = auto (use up to 4 workers based on CPU), ignored when FASTAPI_RELOAD=true
FASTAPI_WORKERS=0

# MangaDex transport (auto|curl_cffi|httpx)
# Both transports identify as a server API client, without browser cookies.
MANGADEX_TRANSPORT=curl_cffi
MANGADEX_RETRIES=1
MANGADEX_TIMEOUT_SECONDS=12
MANGADEX_CONNECT_TIMEOUT_SECONDS=10
MANGADEX_RETRY_BACKOFF_SECONDS=0.35
MANGADEX_UPSTREAM_REQUEST_CONCURRENCY=2
MANGADEX_LATEST_FALLBACK_CONCURRENCY=2
MANGADEX_COOLDOWN_FAST_FAIL_SECONDS=4
MANGADEX_CURL_WORKERS=8
MANGADEX_CURL_IMPERSONATE=chrome131
MANGADEX_HTTP_KEEPALIVE_CONNECTIONS=8
MANGADEX_HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# Bundled TruyenQQ live scraper; no separate server is required.
TRUYEN_BASE_URL=https://truyenqqko.com
# Optional: public QQ relay used only when the direct source blocks the backend (403).
TRUYENQQ_EDGE_URL=https://mangahub-mangadex-edge.vinhytb3010.workers.dev/api/truyenqq-edge
TRUYEN_TIMEOUT=20
TRUYEN_CONNECT_TIMEOUT=5
TRUYEN_REQUEST_DELAY=0.2
TRUYEN_CACHE_TTL=60
TRUYEN_LATEST_TTL=15

# Redis (required when FRONTEND_URL uses HTTPS)
# Main: Aiven Valkey Service URI (valkeys:// is accepted with TLS verification).
REDIS_URL=redis://localhost:6379/0
# Optional content-cache standby: Upstash TLS Redis URI, not its REST endpoint.
REDIS_FALLBACK_URL=
# Defaults to REDIS_URL. Nonces/revocations/rate limits NEVER fail over to standby.
REDIS_SECURITY_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=0.35
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_RECOVERY_CHECK_SECONDS=60
# Enabling standby initializes a one-time login cutoff in the security store.
# Complete new logins after deployment; old sessions must sign in again.
# Automatically defaults to true when FRONTEND_URL uses HTTPS.
# SECURITY_REQUIRE_REDIS=true

# CORS
FRONTEND_URL=http://localhost:8080
CORS_ALLOW_LOCALHOST=false
# Immediate reverse proxies trusted to supply X-Real-IP/X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Image proxy
IMAGE_PROXY_MAX_MB=16
IMAGE_CACHE_MAX_MB=128
IMAGE_CACHE_PRUNE_COOLDOWN_SECONDS=30
IMAGE_PROXY_CURL_WORKERS=8
MANGADEX_IMAGE_CACHE_VERSION=3
MANGADEX_IMAGE_UPSTREAM_CONCURRENCY=3
MANGADEX_IMAGE_THROTTLE_BACKOFF_SECONDS=0.8

# SEO sitemap
SITEMAP_CACHE_TTL_SECONDS=1800
SITEMAP_OTRUYEN_PAGE_LIMIT=30
SITEMAP_OTRUYEN_BATCH_SIZE=10
SITEMAP_OTRUYEN_TIMEOUT_SECONDS=24
SITEMAP_MANGADEX_TIMEOUT_SECONDS=10

# Google reCAPTCHA v2
# Use the secret matching the frontend VITE_RECAPTCHA_SITE_KEY.
# Set these in the BACKEND Vercel project, then redeploy after the frontend has its site key.
RECAPTCHA_SECRET_KEY=REPLACE_WITH_RECAPTCHA_SECRET
RECAPTCHA_REQUIRED=true
RECAPTCHA_TIMEOUT_SECONDS=5

# Support email / SMTP
# Hostinger mailbox example: sender admin@mangahub.art -> support inbox cskh.mangahub@gmail.com.
SUPPORT_EMAIL=cskh.mangahub@gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=admin@mangahub.art
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=admin@mangahub.art
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15

# JWT
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
REFRESH_ROTATION_GRACE_SECONDS=30
# Optional private JWK file, shared by all Flask workers/replicas.
AUTH_CREDENTIAL_KEY_FILE=

# OpenRouter (AI Translation)
# Used by the editor's OCR+Translate feature (nvidia/nemotron model)
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY

# Shared upstream chapter checks; browsers receive changes over SSE. Minimum 5s.
CATALOG_POLL_SECONDS=8
