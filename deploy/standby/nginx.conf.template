map $http_x_mangahub_origin_secret $mh_origin_allowed {
    default 0;
    "ORIGIN_SECRET_PLACEHOLDER" 1;
}
map $http_x_mangahub_public_host $mh_public_host {
    default api.mangahub.art;
    mangahub.art mangahub.art;
    api.mangahub.art api.mangahub.art;
    auth.mangahub.art auth.mangahub.art;
}
# Public image/static reads are still restricted to Cloudflare ingress below.
# Only the signed Worker hop may provide a client-IP override.
map $http_cf_connecting_ip $mh_cloudflare_client_ip {
    default $http_cf_connecting_ip;
    "" $remote_addr;
}
map "$mh_origin_allowed:$http_x_mangahub_client_ip" $mh_client_ip {
    ~^1:(.+)$ $1;
    default $mh_cloudflare_client_ip;
}
map $uri $mh_public_bytes {
    default 0;
    ~^/assets/ 1;
    ~^/(favicon\.(ico|svg)|no-cover\.svg)$ 1;
    ~^/api/images/ 1;
    ~^/api/manga/(mangadex-cover|truyenqq/(cover|image))/ 1;
}
# If Workers are out of quota, an unsigned standby navigation returns to
# the canonical primary rather than exposing a private origin or a 404 page.
# The independent zone country rule must be live before frontend fail-open.
map $uri $mh_quota_navigation {
    default 1;
    ~^/(api|auth|internal)(/|$) 0;
    /auth/callback 1;
}
map "$mh_origin_allowed:$mh_public_bytes:$mh_quota_navigation" $mh_request_allowed {
    default 0;
    ~^1: 1;
    ~^0:1: 1;
    "0:0:1" 1;
}
map $http_user_agent $mh_preview {
    default "";
    ~*(googlebot|bingbot|duckduckbot|yandexbot|baiduspider|slurp) seo;
    ~*(facebookexternalhit|facebot|messenger|zalo|twitterbot|telegrambot|discordbot|whatsapp|linkedinbot|pinterest|slackbot|redditbot) share;
}
# A browser document can arrive as POST after an edge challenge/host handoff.
# Only SPA documents may discard that body; API/auth and static files must keep
# their original method. The origin and ingress gates below still apply first.
map $uri $mh_spa_document {
    default 1;
    ~^/(api|auth|internal|assets|\.well-known)(/|$) 0;
    ~\.[^/]+$ 0;
    /auth/callback 1;
    /index.html 1;
    /health 0;
}
map "$request_method:$mh_spa_document:$http_accept" $mh_frontend_document_post {
    default 0;
    ~*^POST:1:.*text/html 1;
}
server {
    listen 80;
    server_name standby.mangahub.art;
    server_tokens off;
    include /etc/nginx/mangahub-origin-rules/*.conf;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://standby.mangahub.art$request_uri; }
}
server {
    listen 443 ssl;
    server_name standby.mangahub.art;
    server_tokens off;
    include /etc/nginx/mangahub-origin-rules/*.conf;
    ssl_certificate /etc/letsencrypt/live/standby.mangahub.art/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/standby.mangahub.art/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/mangahub/standby/dist;
    client_max_body_size 50m;
    add_header Cache-Control "private, no-store" always;
    if ($mh_request_allowed = 0) { return 404; }
    if ($mh_public_host = "") { return 404; }
    # Daily health metadata is private, never an application proxy or a URL
    # selected by the caller. The server-level origin-secret gate applies.
    # Fixed policy check for the source relay. This stays behind the same
    # origin-secret and Cloudflare ingress gates as private readiness reads.
    # Only the backend decides whether the forwarded reader is allowed.
    location = /internal/source-access {
        limit_except GET OPTIONS { deny all; }
        proxy_pass http://127.0.0.1:8000/api/site-access;
        proxy_http_version 1.1;
        proxy_set_header Host api.mangahub.art;
        proxy_set_header Cookie "";
        proxy_set_header X-Real-IP $mh_client_ip;
        proxy_set_header X-Forwarded-For $mh_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host api.mangahub.art;
        proxy_set_header CF-Connecting-IP "";
        proxy_hide_header X-MangaHub-Origin;
        proxy_buffering off;
        proxy_read_timeout 10s;
        proxy_connect_timeout 2s;
    }
    location = /internal/router-health {
        limit_except GET { deny all; }
        default_type application/json;
        add_header Cache-Control "private, no-store" always;
        alias /var/lib/mangahub-router-health/daily.json;
    }
    # URI error-page dispatch changes POST to GET inside Nginx. A named
    # location would retain POST and reproduce the static-file 405. No browser
    # redirect, Worker invocation or backend request is needed for this step.
    location = /internal/frontend-document {
        internal;
        default_type text/html;
        add_header Cache-Control "private, no-store" always;
        try_files /index.html =404;
    }
    location ~ ^/manga/([^/]+)$ {
        if ($mh_origin_allowed = 0) { return 307 https://mangahub.art$request_uri; }
        error_page 418 = /internal/frontend-document;
        if ($mh_frontend_document_post) { return 418; }
        if ($mh_preview = seo) { rewrite ^/manga/(.+)$ /api/manga/seo/$1 last; }
        if ($mh_preview = share) { rewrite ^/manga/(.+)$ /api/manga/share/$1 last; }
        add_header Cache-Control "private, no-store" always;
        try_files $uri /index.html;
    }
    location ~ ^/chapter/([^/]+)$ {
        if ($mh_origin_allowed = 0) { return 307 https://mangahub.art$request_uri; }
        error_page 418 = /internal/frontend-document;
        if ($mh_frontend_document_post) { return 418; }
        if ($mh_preview = seo) { rewrite ^/chapter/(.+)$ /api/manga/seo-chapter/$1 last; }
        if ($mh_preview = share) { rewrite ^/chapter/(.+)$ /api/manga/share-chapter/$1 last; }
        add_header Cache-Control "private, no-store" always;
        try_files $uri /index.html;
    }
    location = /auth/callback {
        if ($mh_origin_allowed = 0) { return 307 https://mangahub.art$request_uri; }
        error_page 418 = /internal/frontend-document;
        if ($mh_frontend_document_post) { return 418; }
        add_header Cache-Control "private, no-store" always;
        try_files /index.html =404;
    }
    location /assets/ {
        add_header Cache-Control "private, max-age=31536000, immutable";
        try_files $uri @retained_assets;
    }
    location @retained_assets { root /opt/mangahub; try_files $uri =404; }
    location ~ ^/(api/|auth/|health$|internal/origin-status$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $mh_public_host;
        proxy_set_header X-Real-IP $mh_client_ip;
        proxy_set_header X-Forwarded-For $mh_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $mh_public_host;
        proxy_set_header CF-Connecting-IP "";
        proxy_hide_header X-MangaHub-Origin;
        proxy_buffering off;
        proxy_read_timeout 310s;
        proxy_connect_timeout 5s;
    }
    location / {
        if ($mh_origin_allowed = 0) { return 307 https://mangahub.art$request_uri; }
        error_page 418 = /internal/frontend-document;
        if ($mh_frontend_document_post) { return 418; }
        add_header Cache-Control "private, no-store" always;
        try_files $uri /index.html;
    }
}
