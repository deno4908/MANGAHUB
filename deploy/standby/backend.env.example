# Copy all current backend Production settings, not only this subset.
FRONTEND_URL=https://mangahub.art
FLASK_DEBUG=false
FASTAPI_RELOAD=false
FASTAPI_WORKERS=1
ALLOW_DEV_SECRET_FALLBACK=false
SECURITY_REQUIRE_REDIS=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
SUPABASE_URL=REPLACE_WITH_SAME_PRODUCTION_VALUE
SUPABASE_KEY=REPLACE_WITH_SAME_PRODUCTION_VALUE
SUPABASE_SERVICE_KEY=REPLACE_WITH_SAME_PRODUCTION_VALUE
FLASK_SECRET_KEY=REPLACE_WITH_SAME_PRODUCTION_VALUE
JWT_SECRET_KEY=REPLACE_WITH_SAME_PRODUCTION_VALUE
AUTH_CREDENTIAL_PRIVATE_JWK=REPLACE_WITH_SAME_PRODUCTION_VALUE
# Main content cache: the LOCAL Redis TLS URI generated during provisioning.
REDIS_URL=REPLACE_WITH_GENERATED_LOCAL_TLS_URI
# MUST match Vercel's effective security store (REDIS_SECURITY_URL or REDIS_URL).
REDIS_SECURITY_URL=REPLACE_WITH_CURRENT_SHARED_AIVEN_TLS_URI
# Preserve the production setting: enabling fallback also enables its existing login cutoff.
REDIS_FALLBACK_URL=REPLACE_WITH_CURRENT_PRODUCTION_SETTING
TRUYENQQ_EDGE_URL=https://mangahub-mangadex-edge.vinhytb3010.workers.dev/api/truyenqq-edge
RECAPTCHA_SECRET_KEY=REPLACE_WITH_SAME_PRODUCTION_VALUE
RECAPTCHA_REQUIRED=true
STANDBY_ORIGIN_SECRET=REPLACE_WITH_GENERATED_ORIGIN_SECRET
# Keep disabled until config parity, login, both sources, assets and the failure drill pass.
STANDBY_READY=false
# Vercel's shared ingress for the private TLS frontend health check only.
# Must remain a public IP; certificate verification still uses mangahub.art.
STANDBY_PRIMARY_FRONTEND_ADDRESS=76.76.21.21
IMAGE_CACHE_MAX_MB=96
IMAGE_PROXY_MAX_MB=16
# Also preserve SMTP, OpenRouter and any other Production integration settings.
