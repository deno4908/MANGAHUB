[Unit]
Description=MangaHub standby application
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=mangahub
Group=mangahub
WorkingDirectory=/opt/mangahub/standby/backend
EnvironmentFile=/etc/mangahub/standby.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/mangahub/venv/bin/uvicorn standby_app:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --timeout-keep-alive 10 --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
MemoryHigh=480M
MemoryMax=600M
MemorySwapMax=512M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mangahub/standby/backend
UMask=0077

[Install]
WantedBy=multi-user.target
